# Go service (cmd/lankaweather). Copy to .env and adjust; .env is never committed.

# PostgreSQL with PostGIS. Matches compose.yaml for local development.
LANKAWEATHER_DATABASE_URL=postgres://lankaweather:lankaweather@127.0.0.1:55440/lankaweather?sslmode=disable

# HTTP listen address for `lankaweather serve`.
LANKAWEATHER_ADDR=:8080

# Contact sent in the User-Agent of every request to a data source, so
# source operators can reach us. Use a URL or a project mailbox.
LANKAWEATHER_CONTACT=https://github.com/prabhavalabs/lanka-weather

# Google Cloud API key for the Flood Forecasting API (Sri Lanka gauges and
# flood areas). Leave empty to switch the flood forecast off. It is sent
# only in a request header, never logged and never sent to the browser.
LANKAWEATHER_GOOGLE_API_KEY=

# Gauges Google has not quality-verified (Flood Hub's Extended coverage) are
# collected unless this is false. The map keeps them behind a toggle that is
# off by default, and they never raise river risk, alerts or the overview.
# LANKAWEATHER_GOOGLE_FLOOD_UNVERIFIED=false

# Administrative regions for /v1/weather/regions are read from the
# admin_regions view (migration 00004) by default. Name another relation with
# the same columns, or set none to switch region weather off (ADR 0008).
# LANKAWEATHER_WEATHER_REGIONS_RELATION=admin_regions
# LANKAWEATHER_WEATHER_REGIONS=none

# cmd/riverseed writes a pretend flood into a local database, to check how
# floods are drawn when none is happening (ADR 0010). It refuses the database
# named lankaweather, and the map carries a test-data banner while it is in place.
# LANKAWEATHER_ALLOW_SEED=true

# Integration tests use a separate database they may freely reset.
# LANKAWEATHER_TEST_DATABASE_URL=postgres://lankaweather:lankaweather@127.0.0.1:55440/lankaweather_test?sslmode=disable
